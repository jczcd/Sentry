Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RTX PointCloud
      Topic:
        Value: /sentry/lidar/points
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Isaac Ground Truth Odom
      Topic:
        Value: /sentry/odom
      Enabled: true
Window Geometry:
  Width: 1200
  Height: 800
