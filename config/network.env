export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"
export ROS_LOCALHOST_ONLY=0
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
sentinel_network_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export FASTRTPS_DEFAULT_PROFILES_FILE="${sentinel_network_dir}/fastdds.xml"
unset sentinel_network_dir
# Multicast is used by default. If it is blocked, uncomment and replace the IP:
# export ROS_DISCOVERY_SERVER=192.168.1.20:11811
